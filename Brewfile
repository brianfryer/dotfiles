# Homebrew bundle for the refreshed dotfiles setup.
#
# This is the canonical package and application inventory for a fresh machine.
# Keep it focused on tools that belong in the default environment.

# Core shell/runtime tools used directly by the current environment.
brew "coreutils"
brew "git"
brew "zsh"
brew "pyenv"

# Runtime and package-manager tools for project work.
brew "mise"
brew "bun"

# CLI utilities with current usage or explicit keep decisions.
brew "ffmpeg"
brew "imagemagick"
brew "tree"
brew "wifi-password"

# Search, syntax-highlighted output, and JSON processing.
brew "ripgrep"
brew "bat"
brew "jq"

# Git pager configured in .gitconfig.
brew "diff-so-fancy"

# Structured shell history with timestamps, exit status, and working directory
# metadata stored outside plain-text shell history files.
brew "atuin"

# GUI applications.
cask "divvy"
cask "dropbox"
cask "firefox"
cask "github"
cask "google-chrome"
cask "slack"
cask "sonos"
cask "spotify"
cask "steam"

# Current Google Drive and database GUI applications.
cask "google-drive"
cask "sequel-ace"
