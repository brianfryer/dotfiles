#!/usr/bin/env bash

# Interactive shell functions for the default environment.
#
# This file is sourced by `.zshrc`, so functions should earn their place here.
# Prefer clear behavior, quoted variables, and implementations that rely on
# tools managed by Brewfile or macOS itself. If a helper is project-specific or
# rarely needed, keep it out of the global shell surface until it has a current
# workflow.

# Create a directory and enter it.
#
# `mkdir -p` creates nested directories, and `cd` moves the current shell into
# the resulting path only when creation succeeds.
md() {
  mkdir -p "$@" && cd "$@"
}

# Pretty-print JSON from stdin, a file, or an inline string.
#
# `jq` is purpose-built for JSON and is installed through Brewfile.
json() {
  if ! command -v jq >/dev/null 2>&1; then
    printf 'json requires jq. Install it with: brew bundle --file Brewfile\n' >&2
    return 1
  fi

  if [ -p /dev/stdin ]; then
    jq .
  elif [ "$#" -eq 1 ] && [ -f "$1" ]; then
    jq . "$1"
  elif [ "$#" -gt 0 ]; then
    printf '%s\n' "$*" | jq .
  else
    printf 'Usage: json <file|json-string> or pipe JSON into json.\n' >&2
    return 2
  fi
}

# Return to the root of the current Git repository.
#
# This asks Git for the absolute top-level directory and leaves the current
# directory unchanged when the shell is not inside a Git repository.
gr() {
  local root

  if ! root="$(git rev-parse --show-toplevel 2>/dev/null)"; then
    printf 'Not inside a Git repository.\n' >&2
    return 1
  fi

  cd "$root"
}

# Start a static HTTP server for the current directory.
#
# The optional first argument is the port; when omitted, port 8000 is used.
# Python's standard-library server keeps this helper dependency-free beyond the
# system Python installation.
server() {
  local port="${1:-8000}"

  if ! command -v python3 >/dev/null 2>&1; then
    printf 'server requires python3.\n' >&2
    return 1
  fi

  if command -v open >/dev/null 2>&1; then
    open "http://localhost:${port}/" >/dev/null 2>&1 &
  fi

  python3 -m http.server "$port"
}

# Convert a video file into an animated GIF.
#
# ffmpeg's palette workflow generally produces cleaner GIFs than direct video
# conversion and keeps temporary files isolated.
# Usage:
#   gifify input.mov [output.gif]
gifify() {
  if [ "$#" -lt 1 ] || [ "$#" -gt 2 ]; then
    printf 'Usage: gifify <input-video> [output.gif]\n' >&2
    return 2
  fi

  if ! command -v ffmpeg >/dev/null 2>&1; then
    printf 'gifify requires ffmpeg. Install it with: brew bundle --file Brewfile\n' >&2
    return 1
  fi

  local input="$1"
  local output="${2:-$1.gif}"
  local palette

  if [ ! -f "$input" ]; then
    printf "'%s' is not a file.\n" "$input" >&2
    return 1
  fi

  palette="$(mktemp "${TMPDIR:-/tmp}/gifify-palette.XXXXXX.png")"
  ffmpeg -v warning -i "$input" -vf "fps=12,scale=900:-1:flags=lanczos,palettegen" "$palette" &&
    ffmpeg -v warning -i "$input" -i "$palette" -lavfi "fps=12,scale=900:-1:flags=lanczos[x];[x][1:v]paletteuse" "$output"
  local status=$?
  rm -f "$palette"
  return "$status"
}

# Show local interface IP addresses.
#
# This is read-only and uses macOS `networksetup` plus `ipconfig` to print each
# hardware port with the IPv4 address currently assigned to its device, if one
# exists.
localip() {
  if ! command -v networksetup >/dev/null 2>&1; then
    printf 'localip requires networksetup on macOS.\n' >&2
    return 1
  fi

  networksetup -listallhardwareports | awk '
    /^Hardware Port:/ {
      port = substr($0, index($0, ":") + 2)
    }
    /^Device:/ {
      device = $2
      command = "ipconfig getifaddr " device " 2>/dev/null"
      command | getline ip
      close(command)
      if (ip != "") {
        printf "%s (%s): %s\n", port, device, ip
      }
      ip = ""
    }
  '
}

# Evaluate mise environment changes with a clearer trust error.
#
# `mise env -s zsh` emits shell code. This wrapper captures errors first so an
# untrusted directory produces an actionable message instead of a partial eval.
miseenv() {
  local output

  if ! output="$(command mise env -s zsh "$@" 2>&1)"; then
    case "$output" in
      *untrusted*|*Trust*)
        printf 'mise blocked this directory because it is not trusted.\n' >&2
        printf 'Run: mise trust\n' >&2
        return 1
        ;;
      *)
        printf '%s\n' "$output" >&2
        return 1
        ;;
    esac
  fi

  eval "$output" >/dev/null 2>&1
}

# Update Homebrew using supported modern commands.
#
# Language package managers should be updated in their own project contexts,
# not as a global side effect of refreshing Homebrew.
brew_update() {
  brew update
  brew upgrade
  brew cleanup
  brew doctor
}
