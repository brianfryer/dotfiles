# Shell aliases for the default interactive environment.
#
# Keep this file small. Every alias here is loaded on every interactive shell,
# so unused shortcuts create real cost: they hide standard command behavior,
# reserve names, and make fresh-machine setup harder to reason about.

# Directory navigation shortcuts.
alias ..="cd .."
alias ...="cd ../.."
alias ~="cd ~"
alias -- -="cd -"

# File operations. These aliases intentionally preserve the standard command
# names while making destructive or state-changing commands more visible.
alias mv="mv -v"
alias rm="rm -i -v"
alias cp="cp -v"

# Syntax-highlighted file output without paging.
alias c="bat --style=plain --paging=never"

# Git shortcuts.
alias g="git"
alias gbc="git checkout -b"

# Public IP helper. This is read-only and does not alter network state.
alias ip="dig +short myip.opendns.com @resolver1.opendns.com"
